# 复制为 .env 后按自己的环境修改。相对路径按项目根目录解析。.env 已被 .gitignore 排除。

# ---- 构建原生程序 (native/build.ps1) ----
# 贴图与图标目录，里面需要 wall.bc3、spot.bc1、app.ico
WOLF_ASSETS_DIR=assets
# 构建输出目录
WOLF_BUILD_DIR=native/build
# 输出的 exe 文件名
WOLF_EXE_NAME=WolfAmongUsTitleLive.exe
# Visual Studio 安装目录；留空则用 vswhere 自动查找
WOLF_VS_PATH=

# ---- 准备贴图 (tools/prepare-assets.ps1)：下载归档 -> 解出 d3dtx -> 生成 assets ----
# 游戏目录：已安装的游戏（里面有 Archive/ 文件夹）；没有该文件时会用 DepotDownloader 只下载下面那一个归档到这里
WOLF_GAME_DIR=tools/.cache/game
# 包含两张贴图的归档（相对 WOLF_GAME_DIR）
WOLF_ARCHIVE_FILE=Archive/Fables_pc_Boot_ar_txmesh.ttarch2
# 归档里两张贴图的文件名
WOLF_WALLPAPER_NAME=ui_menu_background_wallpaper.d3dtx
WOLF_SPOTLIGHT_NAME=ui_menu_background_spotlight.d3dtx
# TelltaleToolKit 的游戏配置名
WOLF_GAME_PROFILE=the-wolf-among-us-2013
# TelltaleToolKit 源码里 TelltaleToolKit.csproj 的路径（自行 git clone https://github.com/iMrShadow/TelltaleToolKit）
WOLF_TTK_PROJECT=
# 缓存目录（DepotDownloader、解出的 d3dtx、ttk_extract 的构建输出）
WOLF_CACHE_DIR=tools/.cache
# Steam：demo 的 AppID 与用于下载的账号用户名（demo 不允许匿名下载；密码不写进 .env，首次运行时在终端输入）
WOLF_STEAM_APPID=5280090
WOLF_STEAM_USERNAME=
WOLF_DEPOTDOWNLOADER_VERSION=3.4.0
WOLF_DEPOTDOWNLOADER_DIR=tools/.cache/depotdownloader

# ---- 只用 tools/extract_textures.py（手动准备好 d3dtx 时）----
# prepare-assets.ps1 会自动设置这两项；单独运行脚本时在这里填
WOLF_WALLPAPER_D3DTX=
WOLF_SPOTLIGHT_D3DTX=

# ---- 网页版 (web/build_web.py) ----
# tools/d3dtx2png.py 转出的两张 PNG，以及输出的网页
WOLF_WEB_WALL_PNG=web/dist/wall.png
WOLF_WEB_SPOT_PNG=web/dist/spot.png
WOLF_WEB_OUT=web/dist/index.html

# ---- 分析脚本 (tools/) 读取的抓帧 / 导出数据，复现时才用得到 ----
# layer_table.py：目录里放 auto_frame*_draws.txt
WOLF_CAPTURE_DIR=
# menu_summary.py：主菜单抓帧导出的 menu.json
WOLF_MENU_JSON=
# verify_colors.py：密集抓帧导出的 rows.json
WOLF_DENSE_ROWS=
